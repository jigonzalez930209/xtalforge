"""Typed object API: Lattice, Site, Structure, P1Cell and result classes (Task 12.1.3)."""

class SymmetryDataset(dict[str, object]):
    def to_dict(self) -> dict[str, object]: ...
    def _repr_html_(self) -> str: ...
class PxrdPattern(dict[str, object]):
    def to_dict(self) -> dict[str, object]: ...
    def _repr_html_(self) -> str: ...
class PorosityReport(dict[str, object]):
    def to_dict(self) -> dict[str, object]: ...
    def _repr_html_(self) -> str: ...
class OptimizeResult(dict[str, object]):
    def to_dict(self) -> dict[str, object]: ...
    def _repr_html_(self) -> str: ...

class Lattice:
    def __init__(self, a: float, b: float, c: float, alpha: float, beta: float, gamma: float) -> None: ...
    @staticmethod
    def from_matrix(matrix: list[list[float]]) -> Lattice: ...
    a: float
    b: float
    c: float
    alpha: float
    beta: float
    gamma: float
    volume: float
    parameters: list[float]
    matrix: list[list[float]]
    def to_cart(self, point: list[float]) -> list[float]: ...
    def to_frac(self, point: list[float]) -> list[float]: ...
    def d_spacing(self, hkl: list[float]) -> float: ...
    def distance(self, first: list[float], second: list[float]) -> float: ...
    def minimum_image(self, delta: list[float]) -> tuple[list[float], float]: ...
    def scaled_to_volume(self, volume: float) -> Lattice: ...

class Site:
    def __init__(self, label: str, element: str, x: float, y: float, z: float) -> None: ...
    label: str
    element: str
    frac: list[float]
    occupancy: float
    u_iso: float | None
    charge: float | None
    def with_occupancy(self, occupancy: float) -> Site: ...
    def with_charge(self, charge: float) -> Site: ...
    def to_dict(self) -> dict[str, object]: ...

class Structure:
    def __init__(self, text: str, format_hint: str = "") -> None: ...
    @staticmethod
    def from_cif(text: str) -> Structure: ...
    name: str
    formula: str
    hall: str
    lattice: Lattice
    sites: list[Site]
    n_sites: int
    volume: float
    density: float
    is_p1: bool
    def p1(self) -> P1Cell: ...
    def supercell(self, na: int, nb: int, nc: int) -> Structure: ...
    def slab(self, h: int, k: int, l: int, layers: int, vacuum: float) -> Structure: ...
    def bonds(self) -> list[dict[str, object]]: ...
    def rings(self, max_size: int) -> list[list[int]]: ...
    def ring_paths(
        self, max_size: int
    ) -> list[list[tuple[int, tuple[int, int, int]]]]: ...
    def summary(self) -> dict[str, object]: ...
    def to_dict(self) -> dict[str, object]: ...
    def write(self, path: str) -> None: ...
    positions: list[list[float]]
    frac_positions: list[list[float]]
    cell: list[list[float]]
    numbers: list[float]
    @staticmethod
    def from_arrays(cell: list[list[float]], numbers: list[int], frac: list[list[float]] | None = None, cart: list[list[float]] | None = None) -> Structure: ...
    def set_positions(self, frac_positions: list[list[float]]) -> Structure: ...
    def ff_energy(self) -> float: ...
    def add_hydrogens(self, distance: float = 1.09) -> Structure: ...
    def _repr_html_(self) -> str: ...
    def to_format(self, format: str) -> str: ...
    def to_json(self) -> str: ...

class P1Cell:
    n_atoms: int
    lattice: Lattice
    elements: list[str]
    frac: list[float]
    occupancy: list[float]
    atoms: list[dict[str, object]]
