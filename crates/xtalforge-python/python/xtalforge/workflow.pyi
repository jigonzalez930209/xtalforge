from typing import Iterable

class Workflow:
    text: str
    def __init__(self, text: str) -> None: ...
    @staticmethod
    def schema() -> str: ...
    def validate(self) -> dict[str, object]: ...
    def run(self, inputs: Iterable[str], *, jobs: int = 1, checkpoint: str | None = None) -> dict[str, object]: ...
